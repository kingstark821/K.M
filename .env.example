# Numéro(s) owner, indicatif pays sans + ni espace. Plusieurs numéros séparés par des virgules.
OWNER_NUMBER=

# Généré par la commande .getsession une fois le bot connecté une première fois
# (permet de survivre aux redémarrages sans re-scanner/re-pairer à chaque fois).
SESSION_ID=
SESSION_NUMBER=

# IA (.ai, .translate, .summarize, .code, .explain...) — compatible avec toute API
# de type "OpenAI chat completions" (OpenAI, Groq, OpenRouter, Together.ai...).
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# .imagine — endpoint compatible OpenAI Images ou autre générateur d'image
IMAGE_API_URL=
IMAGE_API_KEY=

# .removebg
REMOVEBG_API_KEY=

# Autres outils image (.upscale, .enhance, .unblur, .colorize...)
IMAGE_TOOLS_API_URL=
IMAGE_TOOLS_API_KEY=

# Port HTTP (fourni automatiquement par la plupart des hébergeurs)
PORT=3000
